# Template for .env.dev, .env.lan and .env.prod (see package.json "config.envs").
# Do not name a file .env, .env.local, .env.development or .env.production:
# Expo merges those in on its own and scripts/with-env.js refuses to run.
# Everything here ships inside the app bundle, so no secrets.
EXPO_PUBLIC_ACCOUNT_API_URL=https://api.example.com
EXPO_PUBLIC_MEDICAL_API_URL=https://api.example.com
EXPO_PUBLIC_PROGRESS_API_URL=https://api.example.com
EXPO_PUBLIC_RECOMMENDATION_API_URL=https://api.example.com
# notification-service's API (port 8087), not its worker.
EXPO_PUBLIC_NOTIFICATION_API_URL=https://api.example.com
