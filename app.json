{
  "expo": {
    "name": "Eativio",
    "slug": "eativio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-v2/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.forvuno.eativio",
      "appleTeamId": "7NCH5FSTYT",
      "infoPlist": {
        "CFBundleDisplayName": "Eativio"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-v2/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/brand-v2/adaptive-icon-background.png",
        "monochromeImage": "./assets/brand-v2/adaptive-icon-monochrome.png",
        "backgroundColor": "#123F3A"
      },
      "package": "com.forvuno.eativio",
      "icon": "./assets/brand-v2/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Dietician to access your Face ID to protect your health data."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand-v2/adaptive-icon-monochrome.png",
          "color": "#0F766E",
          "enableRemoteNotifications": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-v2/splash-lockup.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6ED"
        }
      ]
    ]
  }
}
